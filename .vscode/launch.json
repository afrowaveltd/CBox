{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CBox: debug Result test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test_result",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CBox: build Result tests"
    },
    {
      "name": "CBox: debug DoesItFail integration",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test_framework",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CBox: DoesItFail integration"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": ".",
      "program": "build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}